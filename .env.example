# Copy to .env and fill real values.
# Docker Compose reads .env automatically.

# Required: strong random key (>=32 chars) for Flask session signing.
FLASK_SECRET_KEY=replace_with_strong_random_secret

# In Cloudflare HTTPS deployment, keep this true.
SESSION_COOKIE_SECURE=true

# Cloudflare named tunnel token from Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=replace_with_real_tunnel_token

# Self-service sign-up: closed (default) or open.
REGISTRATION_MODE=closed

# Optional bootstrap admin at startup. Leave blank to disable auto-create.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FORCE_RESET=false

# --- Localtest staging stack (docker-compose.localtest.yml) ---
# Separate from the main stack's values above. Generate with:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
LOCALTEST_FLASK_SECRET_KEY=replace_with_strong_random_secret
# Optional bootstrap admin for localtest. FORCE_RESET=true re-applies the password on every start.
# Optional: LAN IP to reach localtest from a phone (default 127.0.0.1). Never 0.0.0.0.
LOCALTEST_BIND_ADDR=
LOCALTEST_ADMIN_USERNAME=
LOCALTEST_ADMIN_PASSWORD=
LOCALTEST_ADMIN_FORCE_RESET=false

# Session key of the public live demo (docker-compose.demo-public.yml); guests sign in with it
DEMO_FLASK_SECRET_KEY=replace_with_strong_random_secret
